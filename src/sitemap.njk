---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/" | absoluteUrl(site.url) }}</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ "/guides/airport-parking-full-what-to-do-and-where-to-park-instead/" | absoluteUrl(site.url) }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% for airport in airports %}
  <url>
    <loc>{{ airport | airportPath | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ airport.lastUpdated }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}
  <url><loc>{{ "/about/" | absoluteUrl(site.url) }}</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
  <url><loc>{{ "/affiliate-disclosure/" | absoluteUrl(site.url) }}</loc><changefreq>monthly</changefreq><priority>0.3</priority></url>
  <url><loc>{{ "/privacy/" | absoluteUrl(site.url) }}</loc><changefreq>monthly</changefreq><priority>0.3</priority></url>
  <url><loc>{{ "/list-your-business/" | absoluteUrl(site.url) }}</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
</urlset>
